# replay: never calls a model; live: attempts the SDK then explicitly falls back;
# auto: live only when DEEPSEEK_API_KEY exists, otherwise replay.
MODEL_MODE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_REASONING_EFFORT=low
DEEPSEEK_TIMEOUT_SECONDS=25
DEEPSEEK_STRUCTURE_REPAIR_RETRIES=1

DATABASE_URL=sqlite:///./shixiaoguan.db
WEB_ORIGIN=http://localhost:3000
UPLOAD_DIR=./var/uploads

# Backward-compatible aliases: SHIXIAOGUAN_DATABASE_URL,
# SHIXIAOGUAN_CORS_ORIGINS, SHIXIAOGUAN_UPLOAD_DIR.
