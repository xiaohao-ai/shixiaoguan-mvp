# replay: never calls a model; live: attempts the SDK then explicitly falls back;
# auto: live only when OPENAI_API_KEY exists, otherwise replay.
MODEL_MODE=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=25
OPENAI_STRUCTURE_REPAIR_RETRIES=1

DATABASE_URL=sqlite:///./shixiaoguan.db
WEB_ORIGIN=http://localhost:3000
UPLOAD_DIR=./var/uploads

# Backward-compatible aliases: SHIXIAOGUAN_DATABASE_URL,
# SHIXIAOGUAN_CORS_ORIGINS, SHIXIAOGUAN_UPLOAD_DIR.
